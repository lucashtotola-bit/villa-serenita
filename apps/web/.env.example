# Modelo de configuração. Copie para `.env` e preencha com os dados do projeto.
#
# Onde encontrar, no painel do Supabase:
#   Project Settings -> API
#     Project URL       -> VITE_SUPABASE_URL
#     Publishable key   -> VITE_SUPABASE_PUBLISHABLE_KEY
#       (em projetos mais antigos aparece como "anon public")
#
# NUNCA colocar aqui a `service_role` / `secret key` nem a senha do banco:
# essas ignoram as regras de segurança e só podem viver no servidor.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
